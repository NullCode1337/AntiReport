# AntiReport configuration template.
# Copy to .env and fill in the token:
#
#     cp .env.example .env
#     chmod 600 .env
#
# Real environment variables take precedence over this file. Blank values fall
# back to the built-in default. Paths are relative to this directory unless
# absolute.

# Discord user token. Required unless ./token.txt exists.
DISCORD_TOKEN=

# Input files. The blacklist takes one term per line. The whitelist is a JSON
# object with two arrays of IDs; user entries may instead be objects carrying a
# per-user webhook flag:
#
#     {
#       "users": [123456789012345678,
#                 {"id": 234567890123456789, "webhook": true}],
#       "servers": [345678901234567890]
#     }
#
# Both files are read once at startup; restart after editing them.
BLACKLIST_FILE=blacklist_words.txt
WHITELIST_FILE=whitelist.json

# Optional word -> emoji map applied to re-posted messages only. Keys are the
# replacement text (any emoji form, e.g. ":skull:" or "<:name:123456789012345678>"),
# values are one word or an array of words:
#
# Set to "none" to disable replacement filtering
REPLACEMENTS_FILE=replacements.json

# word      -> whole-token matching; recommended for this list (ape/ass/anal
#              are separate entries and substring mode would hit "shape")
# substring -> match anywhere inside a word
MATCH_MODE=word

# Delete pipeline: concurrent HTTP workers and queued deletes before shedding.
DELETE_WORKERS=2
DELETE_QUEUE_SIZE=512

# Message-id ring used to attribute edits (raw MESSAGE_UPDATE has no author).
AUTHOR_INDEX_SIZE=2048

# Re-post deleted messages to a Discord webhook after deletion. Only users with
# "webhook": true in whitelist.json are forwarded; none means nobody. Image
# attachments are downloaded into memory and uploaded with the post, capped per
# message and per file to keep RAM use bounded on a small host.
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_MAX_IMAGES=4
WEBHOOK_MAX_IMAGE_MB=8

# Optional rotating log file (2 MB x 3 backups). Empty = stdout only.
LOG_FILE=
LOG_LEVEL=INFO
