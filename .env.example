# AntiReport configuration template.
# Copy to .env and fill in the token:
#
#     cp .env.example .env
#     chmod 600 .env
#
# Real environment variables take precedence over this file. Blank values fall
# back to the built-in default. Paths are relative to this directory unless
# absolute.

# Discord user token. Required unless ./token.txt exists.
DISCORD_TOKEN=

# Matcher input files. One term per line; whitelist takes one user ID per line
# (or comma/space separated). Both are re-read when their mtime changes.
BLACKLIST_FILE=blacklist_words.txt
WHITELIST_FILE=whitelist_users.txt

# word      -> whole-token matching; recommended for this list (ape/ass/anal
#              are separate entries and substring mode would hit "shape")
# substring -> match anywhere inside a word
MATCH_MODE=word

# Delete pipeline: concurrent HTTP workers and queued deletes before shedding.
DELETE_WORKERS=2
DELETE_QUEUE_SIZE=512

# Message-id ring used to attribute edits (raw MESSAGE_UPDATE has no author).
AUTHOR_INDEX_SIZE=2048

# Re-post each deleted message to a Discord webhook after it is deleted.
# Set to true and paste the webhook URL below.
WEBHOOK_ENABLED=false
WEBHOOK_URL=

# Optional rotating log file (2 MB x 3 backups). Empty = stdout only.
LOG_FILE=
LOG_LEVEL=INFO
